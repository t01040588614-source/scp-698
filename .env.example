# DOCX docker-compose (루트)
# copy → .env 후 docker compose up --build

# PostgreSQL (db 서비스)
POSTGRES_USER=krstock
POSTGRES_PASSWORD=krstockpass
POSTGRES_DB=krstock

# API (FastAPI — 포트 8000)
DATABASE_URL=postgresql+asyncpg://krstock:krstockpass@db:5432/krstock
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-32chars
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Web (Next.js — docker compose web 서비스)
STOCK_API_PROXY=http://api:8000
NEXT_PUBLIC_API_URL=http://api:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/api/v1/ws/stocks
