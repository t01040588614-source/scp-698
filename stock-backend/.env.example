# 프로젝트
PROJECT_NAME=Stock API
DEBUG=True
API_V1_PREFIX=/api/v1

# DOCX docker-compose Postgres 16 (권장 — 스크리너·재무 시드 DB 저장)
DATABASE_URL=postgresql+asyncpg://krstock:krstockpass@localhost:5432/krstock

# 로컬만 빠르게 (스크리너 DB 저장 불가)
# DATABASE_URL=sqlite+aiosqlite:///./stock.db

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# === API 키 (입력 시 자동 적용) — UI: /tools/integrations ===
# 한국투자증권 (KIS_APP_* 또는 아래 별칭)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_USE_MOCK=
KIS_ACCOUNT_NO=
KOREA_STOCK_API_KEY=
KOREA_STOCK_API_SECRET=

# 미국 시세
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
US_STOCK_API_KEY=

# OAuth (리다이렉트: {OAUTH_BACKEND_BASE}/api/v1/auth/oauth/{google|kakao}/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
OAUTH_BACKEND_BASE=http://127.0.0.1:8000
OAUTH_FRONTEND_BASE=http://localhost:3000

# SMS 본인인증 (회원가입) — SMS_PROVIDER: aligo | ncp | twilio
SMS_PROVIDER=
SMS_DEMO_MODE=false
# Aligo (https://smartsms.aligo.in/)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
ALIGO_TEST_MODE=y
# NCP SENS
NCP_SMS_SERVICE_ID=
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SMS_SENDER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# AI 챗봇 (하나만 입력해도 됨 — UI: /tools/integrations)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_CHAT_PROVIDER=
OPENAI_MODEL=
GEMINI_MODEL=
OPENAI_BASE_URL=

# 기타
NEWS_API_KEY=
FCM_SERVER_KEY=
# INTEGRATIONS_ALLOW_UI_SAVE=true   # 비우면 DEBUG=True 일 때 UI 저장 허용 (빈 값=오류 방지용 주석 처리)

REDIS_URL=redis://localhost:6379
CACHE_TTL=300
